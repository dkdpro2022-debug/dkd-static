#!/usr/bin/env bash
set -euo pipefail

if [ "${SKIP_GITLEAKS:-}" = "1" ] || [ "${SKIP:-}" = "gitleaks" ]; then
  echo "Skipping Gitleaks pre-commit scan."
  exit 0
fi

if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks git --pre-commit --redact --staged --verbose
fi

if command -v docker >/dev/null 2>&1; then
  exec docker run --rm \
    -v "$PWD:/repo" \
    ghcr.io/gitleaks/gitleaks:v8.30.0 \
    git --pre-commit --redact --staged --verbose /repo
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<'EOF'
Gitleaks is required by this repo's pre-commit hook, but neither gitleaks nor docker is installed.

Install Gitleaks, then retry the commit:
  https://github.com/gitleaks/gitleaks#installing

Temporary emergency bypass:
  SKIP_GITLEAKS=1 git commit ...
EOF
  exit 1
fi
